# ---- Server ----
PORT=4000
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

# ---- Redis (cache + BullMQ) ----
REDIS_URL=redis://localhost:6379

# ---- Postgres (users, price history) ----
DATABASE_URL=postgres://hydrafly:hydrafly@localhost:5432/hydrafly

# ---- MongoDB (raw scraped payloads) ----
MONGO_URL=mongodb://hydrafly:hydrafly@localhost:27017/hydrafly_raw?authSource=admin

# ---- Auth ----
JWT_SECRET=change-me-to-a-long-random-string
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- Fixed origin ----
DEFAULT_ORIGIN=HYD

# ---- GDS / paid APIs (OPTIONAL) ----
# Leave blank to run in pure-scraping mode. When set, the amadeus adapter
# in src/services/amadeus.js is used instead of the Playwright scraper for
# structured routes, and the scraper becomes the fallback/enrichment source.
AMADEUS_API_KEY=
AMADEUS_API_SECRET=
SKYSCANNER_API_KEY=
KIWI_API_KEY=

# ---- Currency conversion ----
EXCHANGE_RATE_API_KEY=

# ---- Push notifications ----
FIREBASE_SERVER_KEY=
WEBPUSH_PUBLIC_KEY=
WEBPUSH_PRIVATE_KEY=

# ---- Scraper tuning ----
SCRAPE_CONCURRENCY=2
SCRAPE_MIN_DELAY_MS=1500
SCRAPE_MAX_DELAY_MS=5000
SCRAPE_CRON=0 */2 * * *

# ---- Observability ----
SENTRY_DSN=
